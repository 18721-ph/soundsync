{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SoundSync web (manual Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": ["--web-hostname=127.0.0.1", "--web-port=8080"]
    },
    {
      "name": "SoundSync Chrome (debugger)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    }
  ]
}
